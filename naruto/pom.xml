{
  "openapi": "3.0.0",

  "info": {

    "title": "Naruto API",

    "version": "1.0.0",

    "description":
      "Microservicio Naruto usando Java + Supabase",

    "contact": {

      "name": "AnimeVerse API",

      "email": "support@animeverse.com"
    }
  },

  "servers": [

    {

      "url": "https://proyectofinal-1-ai7r.onrender.com",

      "description": "Servidor Producción"
    },

    {

      "url": "http://localhost:3002",

      "description": "Servidor Local"
    }
  ],

  "tags": [

    {

      "name": "Naruto",

      "description":
        "Operaciones relacionadas con personajes Naruto"
    },

    {

      "name": "System",

      "description":
        "Estado del sistema"
    }
  ],

  "paths": {

    "/": {

      "get": {

        "tags": [
          "System"
        ],

        "summary":
          "Home API",

        "description":
          "Endpoint principal del microservicio",

        "responses": {

          "200": {

            "description":
              "API funcionando correctamente",

            "content": {

              "application/json": {

                "schema": {

                  "$ref":
                    "#/components/schemas/HomeResponse"
                }
              }
            }
          }
        }
      }
    },

    "/health": {

      "get": {

        "tags": [
          "System"
        ],

        "summary":
          "Health Check",

        "description":
          "Verifica el estado del servidor",

        "responses": {

          "200": {

            "description":
              "Servidor funcionando",

            "content": {

              "application/json": {

                "schema": {

                  "$ref":
                    "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },

    "/api/naruto": {

      "get": {

        "tags": [
          "Naruto"
        ],

        "summary":
          "Obtener personajes Naruto",

        "description":
          "Devuelve todos los personajes almacenados en Supabase",

        "responses": {

          "200": {

            "description":
              "Lista de personajes",

            "content": {

              "application/json": {

                "schema": {

                  "type": "array",

                  "items": {

                    "$ref":
                      "#/components/schemas/Character"
                  }
                }
              }
            }
          },

          "500": {

            "description":
              "Error interno del servidor"
          }
        }
      }
    }
  },

  "components": {

    "schemas": {

      "Character": {

        "type": "object",

        "properties": {

          "id": {

            "type": "integer",

            "example": 1
          },

          "name": {

            "type": "string",

            "example": "Naruto Uzumaki"
          },

          "village": {

            "type": "string",

            "example": "Konoha"
          },

          "role": {

            "type": "string",

            "example": "Hokage"
          },

          "chakra_level": {

            "type": "integer",

            "example": 9500
          },

          "image": {

            "type": "string",

            "example":
              "https://i.imgur.com/8Qf6XGf.png"
          }
        },

        "required": [

          "id",

          "name",

          "village",

          "role"
        ]
      },

      "HealthResponse": {

        "type": "object",

        "properties": {

          "status": {

            "type": "string",

            "example": "ok"
          }
        }
      },

      "HomeResponse": {

        "type": "object",

        "properties": {

          "service": {

            "type": "string",

            "example": "Naruto API"
          },

          "status": {

            "type": "string",

            "example": "Running"
          },

          "endpoints": {

            "type": "object",

            "properties": {

              "api": {

                "type": "string",

                "example":
                  "/api/naruto"
              },

              "health": {

                "type": "string",

                "example":
                  "/health"
              },

              "swagger": {

                "type": "string",

                "example":
                  "/api-docs"
              }
            }
          }
        }
      }
    }
  }
}
